GOOGLE_MAPS_API_KEY=
PORT=8787
# 30 days in ms
CACHE_TTL_MS=2592000000
ADMIN_TOKEN=

# Free durable history + billing (Turso) — survives Render Free sleep/redeploy.
# Create at https://turso.tech (plan free) then:
#   turso db create courseok-history
#   turso db show courseok-history --url
#   turso db tokens create courseok-history
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Durable GitHub Gist fallback (when Turso is not set)
GITHUB_TOKEN=
BILLING_GIST_ID=
ANALYTICS_GIST_ID=
HISTORY_GIST_ID=
ROUTES_GIST_ID=

# SumUp Online Payments (Hosted Checkout) — https://developer.sumup.com
# Merchant profile → API keys + merchant code. Not the physical card reader alone.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
# Optional shared secret for POST /api/billing/sumup-webhook
SUMUP_WEBHOOK_SECRET=
# Optional public base URL of this backend (docs / webhooks)
PUBLIC_BASE_URL=
# Upstream APK URL for /downloads/CourseOK-latest.apk redirect (keep private in env)
APK_DOWNLOAD_URL=
